# Required. Get a token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Optional GitHub token. Lifts the 60 requests/hour anonymous rate limit and
# lets /status read workflow runs. A fine-grained token with no scopes is enough
# for public repositories.
GITHUB_TOKEN=

# Leave both empty to long-poll (best for a VPS). Set WEBHOOK_URL to serve a
# webhook instead; WEBHOOK_SECRET is validated against the
# X-Telegram-Bot-Api-Secret-Token header and is required in production.
# WEBHOOK_URL=https://kazesu-bot.onrender.com
# WEBHOOK_SECRET=

# Optional. Space- or comma-separated chat IDs; when set the bot ignores every
# other chat. Send /id in the target chat to discover the ID.
# ALLOWED_CHAT_IDS=

KAZESU_REPO=KazeSU/KazeSU
KAZESU_SITE_REPO=KazeSU/KazeSU.github.io
KAZESU_WEBSITE=https://kazesu.github.io
KAZESU_TELEGRAM_URL=https://t.me/KazeKSU
# KAZESU_DEVICES_URL=https://raw.githubusercontent.com/KazeSU/KazeSU.github.io/main/docs/repos.json

# HTTP port for webhook mode (Render injects PORT itself).
PORT=8080
LOG_LEVEL=INFO
